# Entity: skill

main: kit: entity: skill: {

  alias: field: {}

  fields: {
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "A description of the skill"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the skill"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the skill"
      t: "`$STRING`"
    }
    ranks: {
      h: "Ranks"
      n: "ranks"
      r: false
      sh: "An array of skill ranks"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "skill"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /skills"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "p"
                or: "p"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/skills"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "skills"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /skills/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
            query: [
              {
                k: "query"
                n: "p"
                or: "p"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/skills/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "skills"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
