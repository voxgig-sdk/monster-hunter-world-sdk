            media: "application/json"
          }
          s: [
            {
              lit: "armor"
            }
            {
              lit: "sets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /armor/sets/{id}"
