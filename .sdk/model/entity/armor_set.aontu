  id: {
    field: "id"
    name: "id"
  }

  name: "armor_set"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /armor/sets"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "p"
                or: "p"
