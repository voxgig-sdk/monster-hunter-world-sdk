# Entity: charm

main: kit: entity: charm: {

  alias: field: {}

  fields: {
    crafting: {
      h: "Crafting"
      n: "crafting"
      r: false
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID of the charm"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the charm"
      t: "`$STRING`"
    }
    rarity: {
      h: "Rarity"
      n: "rarity"
      r: false
      sh: "The rarity of the charm"
      t: "`$INTEGER`"
    }
    skills: {
      h: "Skills"
      n: "skills"
      r: false
      sh: "An array of skill ranks granted by the charm"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "charm"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /charms"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "p"
                or: "p"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/charms"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "charms"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /charms/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
            query: [
              {
                k: "query"
                n: "p"
                or: "p"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/charms/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "charms"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
