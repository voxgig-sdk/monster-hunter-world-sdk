# Entity: item

main: kit: entity: item: {

  alias: field: {}

  fields: [
    {
      name: "buyPrice"
      req: false
      short: "The price when buying the item"
      type: "`$INTEGER`"
    }
    {
      name: "carryLimit"
      req: false
      short: "The maximum number of this item that can be carried"
      type: "`$INTEGER`"
    }
    {
      name: "description"
      req: false
      short: "A description of the item"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The ID of the item"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The name of the item"
      type: "`$STRING`"
    }
    {
      name: "rarity"
      req: false
      short: "The rarity of the item"
      type: "`$INTEGER`"
    }
    {
      name: "sellPrice"
      req: false
      short: "The price when selling the item"
      type: "`$INTEGER`"
    }
    {
      name: "value"
      req: false
      short: "The value of the item"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "item"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/items"
          segments: [
            {
              lit: "items"
            }
          ]
          select: {
            exist: [
              "p"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/items/{id}"
          segments: [
            {
              lit: "items"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "p"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
