# Entity: weapon

main: kit: entity: weapon: {

  alias: field: {}

  fields: [
    {
      name: "assets"
      req: false
      short: "Asset URLs for the weapon"
      type: "`$OBJECT`"
    }
    {
      name: "attack"
      req: false
      short: "Attack values for the weapon"
      type: "`$OBJECT`"
    }
    {
      name: "attributes"
      req: false
      short: "Additional weapon attributes"
      type: "`$OBJECT`"
    }
    {
      name: "crafting"
      req: false
      short: "Crafting information for the weapon"
      type: "`$OBJECT`"
    }
    {
      name: "damageType"
      req: false
      short: "The damage type of the weapon"
      type: "`$STRING`"
    }
    {
      name: "elements"
      req: false
      short: "Elemental damage information"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "The ID of the weapon"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The name of the weapon"
      type: "`$STRING`"
    }
    {
      name: "rarity"
      req: false
      short: "The rarity of the weapon"
      type: "`$INTEGER`"
    }
    {
      name: "slots"
      req: false
      short: "An array of decoration slot information"
      type: "`$ARRAY`"
    }
    {
      name: "type"
      req: false
      short: "The type of weapon"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "weapon"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/weapons"
          parts: [
            "weapons"
          ]
          select: {
            exist: [
              "p"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/weapons/{id}"
          parts: [
            "weapons"
            "{id}"
          ]
          select: {
            exist: [
              "id"
              "p"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
