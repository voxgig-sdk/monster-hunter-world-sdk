# Entity: event

main: kit: entity: event: {

  alias: field: {}

  fields: [
    {
      name: "camps"
      req: false
      short: "An array of camps in the location"
      type: "`$ARRAY`"
    }
    {
      name: "description"
      req: false
      short: "A description of the event"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "endTimestamp"
      req: false
      short: "The end time of the event"
      type: "`$STRING`"
    }
    {
      name: "exclusive"
      req: false
      short: "Whether the event is exclusive to a platform"
      type: "`$STRING`"
    }
    {
      name: "expansion"
      req: false
      short: "The expansion the event belongs to"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The ID of the location"
      type: "`$INTEGER`"
    }
    {
      name: "location"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "name"
      req: false
      short: "The name of the location"
      type: "`$STRING`"
    }
    {
      name: "platform"
      req: false
      short: "The platform for the event"
      type: "`$STRING`"
    }
    {
      name: "questRank"
      req: false
      short: "The quest rank of the event"
      type: "`$STRING`"
    }
    {
      name: "requirements"
      req: false
      short: "Requirements for the event"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "startTimestamp"
      req: false
      short: "The start time of the event"
      type: "`$STRING`"
    }
    {
      name: "successConditions"
      req: false
      short: "Conditions for success"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "The type of event"
      type: "`$STRING`"
    }
    {
      name: "zoneCount"
      req: false
      short: "The number of zones in the location"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "event"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/events"
          segments: [
            {
              lit: "events"
            }
          ]
          select: {
            exist: [
              "p"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "p"
                orig: "p"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/events/{id}"
          segments: [
            {
              lit: "events"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "p"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.location`"
          }
        }
      ]
    }
  }



}
